#!/bin/sh
[ -f "$(dirname "$0")/_/husky.sh" ] && . "$(dirname "$0")/_/husky.sh"

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Skip validation for commits git/tools generate themselves
case "$commit_msg" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*)
    exit 0
    ;;
esac

# ── Load config from package.json → "naicHooks" (falls back to sane defaults) ──
# naicHooks: { "useModules": true, "modules": [...], "types": [...] }
eval "$(node -e "
  const fs = require('fs');
  let cfg = {};
  try { cfg = (JSON.parse(fs.readFileSync('package.json', 'utf8')).naicHooks) || {}; } catch (e) {}
  const useModules = cfg.useModules !== undefined ? cfg.useModules : true;
  const modules = (cfg.modules || ['PRO','AUTH','DMS','PRS','SET','VMS','REP']).join('|');
  const types = (cfg.types || ['feat','feature','fix','docs','style','refactor','test','chore','perf','ci','build','revert']).join('|');
  console.log('USE_MODULES=' + useModules);
  console.log('MODULES=\"' + modules + '\"');
  console.log('TYPES=\"' + types + '\"');
" 2>/dev/null)"

if [ -z "$TYPES" ]; then
    echo ""
    echo "  Could not load naicHooks config — is Node.js installed and is this running from the repo root?"
    echo ""
    exit 1
fi

# ── Commit message format ───────────────────────────────────────────────────
if [ "$USE_MODULES" = "true" ]; then
    # Format : (TICKET) [MODULE] type(scope): message
    # Example: (ECIS-1077) [SET] feature(organization structure): implement organization management
    valid_commit_regex="^\([A-Z]+-[0-9]+\) \[($MODULES)\] ($TYPES)(\([^)]+\))?: .+"
else
    # Format : (TICKET) type(scope): message
    # Example: (ECIS-1077) feature(organization structure): implement organization management
    valid_commit_regex="^\([A-Z]+-[0-9]+\) ($TYPES)(\([^)]+\))?: .+"
fi

if [[ ! $commit_msg =~ $valid_commit_regex ]]; then
    echo ""
    echo "  Invalid commit message: '$commit_msg'"
    echo ""
    if [ "$USE_MODULES" = "true" ]; then
        echo "  Required format : (TICKET) [MODULE] type(scope): message"
        echo "  Example         : (ECIS-1077) [SET] feature(organization structure): implement organization management"
        echo "  Example         : (ECIS-1191) [SET] fix(register): reset registration session on menu reopen"
    else
        echo "  Required format : (TICKET) type(scope): message"
        echo "  Example         : (ECIS-1077) feature(organization structure): implement organization management"
        echo "  Example         : (ECIS-1191) fix(register): reset registration session on menu reopen"
    fi
    echo ""
    echo "  Ticket  : (PROJECT-NUMBER), e.g. (ECIS-1191)"
    [ "$USE_MODULES" = "true" ] && echo "  Modules : $(echo $MODULES | tr '|' ' ')"
    echo "  Types   : $(echo $TYPES | tr '|' ' ')"
    echo "  Scope   : optional — e.g. fix(register): ..."
    echo ""
    exit 1
fi

if [ "$USE_MODULES" = "true" ]; then
    # ── Keep [MODULE] consistent with the branch ────────────────────────────
    # e.g. bugfix/SET-ECIS-1127-... -> commit must be tagged [SET]
    local_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
    branch_module=$(printf '%s' "$local_branch" | sed -nE "s#^[a-z]+/($MODULES)-.*#\1#p")
    commit_module=$(printf '%s' "$commit_msg" | sed -nE 's/^\([A-Z]+-[0-9]+\) \[([A-Z]+)\].*/\1/p')

    if [ -n "$branch_module" ] && [ "$branch_module" != "$commit_module" ]; then
        echo ""
        echo "  Commit module [$commit_module] does not match the branch module [$branch_module]."
        echo "  Branch : $local_branch"
        echo "  Use [$branch_module] to match the branch, e.g. (ECIS-1191) [$branch_module] fix(scope): ..."
        echo ""
        exit 1
    fi
fi
