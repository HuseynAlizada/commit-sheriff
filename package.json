{
  "name": "commit-sheriff",
  "version": "1.7.6",
  "description": "Shared husky commit-msg / pre-commit hooks enforcing ticket-based commit messages and branch naming",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuseynAlizada/commit-sheriff.git"
  },
  "homepage": "https://github.com/HuseynAlizada/commit-sheriff#readme",
  "bugs": {
    "url": "https://github.com/HuseynAlizada/commit-sheriff/issues"
  },
  "bin": {
    "commit-sheriff": "bin/commit-sheriff.js"
  },
  "files": [
    "bin",
    "templates"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky"
  },
  "keywords": [
    "husky",
    "git-hooks",
    "commit-msg",
    "pre-commit",
    "commitlint",
    "conventional-commits",
    "lint-staged",
    "branch-naming",
    "ticket",
    "eslint",
    "prettier",
    "module-boundaries",
    "typescript",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html}": [
      "prettier --write"
    ]
  }
}
